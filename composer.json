{
    "name": "parvion/laravel-msg91",
    "description": "A robust Laravel wrapper for MSG91 (v5) supporting OTP, SMS, Email, and WhatsApp with full database logging.",
    "keywords": [
        "laravel",
        "msg91",
        "otp",
        "sms",
        "whatsapp",
        "email",
        "notification",
        "parvion"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/AnandKumar2002/laravel-msg91",
    "support": {
        "issues": "https://github.com/AnandKumar2002/laravel-msg91/issues",
        "source": "https://github.com/AnandKumar2002/laravel-msg91"
    },
    "authors": [
        {
            "name": "Anand Kumar",
            "email": "anandkumar101002@gmail.com",
            "homepage": "https://parvion.in",
            "role": "Creator"
        }
    ],
    "require": {
        "php": "^8.1.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.5|^1.6",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Parvion\\Msg91\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Parvion\\Msg91\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Parvion\\Msg91\\Msg91ServiceProvider"
            ],
            "aliases": {
                "Msg91": "Parvion\\Msg91\\Facades\\Msg91"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    }
}
