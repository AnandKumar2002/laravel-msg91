{
    "name": "parvion/laravel-msg91",
    "description": "Enterprise-grade MSG91 API wrapper for Laravel — OTP, SMS, Email & WhatsApp with a clean Facade API, Livewire components, strongly-typed DTOs, Events, queued Jobs, and a built-in Fake for testing.",
    "keywords": [
        "laravel",
        "msg91",
        "otp",
        "sms",
        "whatsapp",
        "email",
        "notification",
        "parvion"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Parvion",
            "email": "hello@parvion.com",
            "homepage": "https://parvion.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/contracts": "^10.0|^11.0",
        "illuminate/queue": "^10.0|^11.0",
        "illuminate/events": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.0",
        "livewire/livewire": "^3.0"
    },
    "suggest": {
        "livewire/livewire": "Required to use the built-in OTP verification Livewire component (^3.0)."
    },
    "autoload": {
        "psr-4": {
            "Parvion\\Msg91\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Parvion\\Msg91\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Parvion\\Msg91\\Msg91ServiceProvider"
            ],
            "aliases": {
                "Msg91": "Parvion\\Msg91\\Facades\\Msg91"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit",
        "format": "vendor/bin/pint"
    }
}
